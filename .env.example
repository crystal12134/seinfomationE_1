# STS 실행 구성의 Environment 탭 또는 호스팅 환경변수에 설정하세요.
# 이 파일 자체를 Spring Boot가 자동으로 읽지는 않습니다.
SEINFO_DB_USER=기존_MySQL_접속계정
SEINFO_DB_PASSWORD=기존_MySQL_접속비밀번호
SEINFO_JWT_SECRET=별도_키파일의_JWT_값
SEINFO_SMTP_USER=메일_발송계정
SEINFO_SMTP_PASSWORD=메일_앱비밀번호
SEINFO_COMPANY_API_KEY=기존_사업자_API_키
SEINFO_ADDRESS_API_KEY=기존_주소_API_키
# 선택: DB 주소를 바꿀 때 포트와 DB명을 실제 환경에 맞추세요.
# 일반 MySQL JDBC URL을 사용하면 아래 드라이버도 함께 지정하세요.
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# SEINFO_DB_URL=jdbc:mysql://127.0.0.1:3307/seinfomationa_secure?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# 운영 환경에서 추가 설정
# SPRING_PROFILES_ACTIVE=build
# SEINFO_SERVER_TYPE=production
# SEINFO_PORT=8080
# SEINFO_PUBLIC_URL=https://실제사이트주소

SEINFO_DATA_KEY=이_DB와_함께_제공된_데이터키
SEINFO_LOOKUP_KEY=이_DB와_함께_제공된_조회키
